{
    "name": "devoashim/automate",
    "description": "Laravel Automation Steps - Automate your Laravel project setup with simple button clicks",
    "type": "library",
    "keywords": ["laravel", "automation", "package", "artisan"],
    "license": "MIT",
    "authors": [
        {
            "name": "Washim Akram",
            "email": "devwashim@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2",
        "illuminate/support": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "DevOashim\\Automate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DevOashim\\Automate\\AutomateServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}